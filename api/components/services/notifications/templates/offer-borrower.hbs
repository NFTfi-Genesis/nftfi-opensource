{{> header
    title="You have received the first loan offer on a newly listed asset"
    subtitle="If you receive more loan offers on this or other assets later, we'll send you a nightly digest of all loan offers on your listed assets."
    logoUrl=logoUrl
    walletUrl=walletUrl
    walletAddress=borrower
}}

<table class="row h-align-left v-align-middle" border="0" cellpadding="0" cellspacing="0" role="presentation"
    style="border-collapse: collapse;width: 100%;">
    <tbody>
        <tr>
            <td class="row-content"
                style="background: #f4f3f8;vertical-align: top;background-color: #f4f3f8;border-radius: 20px;text-align: left;">
                <div class="col col-5 col-sm-12"
                    style="text-align: left;display: inline-block;width: 41%;max-width: 41%;vertical-align: middle;">
                    <table class="ms-t1 col-table" width="100%" border="0" cellpadding="0" cellspacing="0"
                        role="presentation" style="border-collapse: collapse;width: 100%;vertical-align: top;">
                        <tbody>
                            <tr>
                                <td class="col-content p-sm-10px pr-sm-20px pl-sm-20px pt-sm-20px"
                                    style="vertical-align: top;padding-left: 40px;padding-top: 40px;padding-bottom: 30px;">
                                   <img
                                        class="img-fluid w-sm-100per" src="{{ imagePreviewUrl }}"
                                        style="display: block;height: auto;border-width: 10.5px;border-radius: 10px;max-width: 100%;">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col col-7 col-sm-12"
                    style="text-align: left;display: inline-block;width: 58%;max-width: 58%;vertical-align: middle;">
                    <table class="ms-t1 col-table" width="100%" border="0" cellpadding="0" cellspacing="0"
                        role="presentation" style="border-collapse: collapse;width: 100%;vertical-align: top;">
                        <tbody>
                            <tr>
                                <td class="col-content pr-sm-20px pl-sm-20px"
                                    style="vertical-align: top;padding-right: 30px;padding-left: 30px;">
                                    <table class="row h-align-left v-align-top" border="0" cellpadding="0"
                                        cellspacing="0" role="presentation"
                                        style="border-collapse: collapse;width: 100%;">
                                        <tbody>
                                            <tr>
                                                <td class="row-content" style="vertical-align: top;text-align: left;">
                                                    <div class="col col-12"
                                                        style="text-align: left;display: inline-block;width: 100%;max-width: 100%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content"
                                                                        style="vertical-align: top;">
                                                                        <h1
                                                                            style="font-weight: bold;margin: 0 0 10px 0;mso-line-height-rule: exactly;font-size: 175%;margin-bottom: 0px;">
                                                                            <strong><span
                                                                                    style="color: rgb(22, 21, 45);">{{ assetName }}</span></strong></h1><a
                                                                            href="#"
                                                                            style="text-decoration: none;color: #7e5bd6;">{{assetCategory}}</a>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col col-12"
                    style="text-align: left;display: inline-block;width: 100%;max-width: 100%;vertical-align: middle;">
                    <table class="ms-t1 col-table" width="100%" border="0" cellpadding="0" cellspacing="0"
                        role="presentation" style="border-collapse: collapse;width: 100%;vertical-align: top;">
                        <tbody>
                            <tr>
                                <td class="col-content pr-sm-10px pl-sm-10px"
                                    style="vertical-align: top;padding-right: 30px;padding-left: 30px;">
                                    <table class="row h-align-left v-align-top" border="0" cellpadding="0"
                                        cellspacing="0" role="presentation"
                                        style="border-collapse: collapse;width: 100%;">
                                        <tbody>
                                            <tr>
                                                <td class="row-content" style="vertical-align: top;text-align: left;">
                                                    <div class="col col-12 col-sm-12"
                                                        style="text-align: left;display: inline-block;width: 100%;max-width: 100%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content p-sm-10px pb-sm-0px pt-sm-0px"
                                                                        style="vertical-align: top;padding-right: 10px;padding-left: 10px;">
                                                                        <p style="margin: 0 0 10px 0;mso-line-height-rule: exactly;margin-top: 5px;margin-bottom: 5px;margin-right: 0px;margin-left: 0px;"
                                                                            class="mt-sm-10px dark-paragraph mb-sm-20px">
                                                                            Lender <span
                                                                                style="text-decoration: underline;">{{ compactAddress lender}}</span>
                                                                            has made an offer on the listed asset
                                                                             <strong>{{assetName}}</strong>.</p>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <table class="row h-align-center v-align-top" border="0" cellpadding="0"
                                        cellspacing="0" role="presentation"
                                        style="border-collapse: collapse;width: 100%;height: 10px;">
                                        <tbody>
                                            <tr>
                                                <td class="row-content"
                                                    style="vertical-align: top;height: 10px;text-align: center;">
                                                    <div class="col col-12 col-sm-12"
                                                        style="text-align: left;display: inline-block;width: 100%;max-width: 100%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content pt-sm-0px pb-sm-10px"
                                                                        style="vertical-align: top;padding: 10px;padding-bottom: 0px;padding-top: 10px;height: 10px;">
                                                                        <small style="color: #8e969f;">OFFER
                                                                            RECEIVED</small></td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <table class="row h-align-center v-align-top" border="0" cellpadding="0"
                                        cellspacing="0" role="presentation"
                                        style="border-collapse: collapse;width: 100%;">
                                        <tbody>
                                            <tr>
                                                <td class="row-content" style="vertical-align: top;text-align: left;">
                                                    <div class="col col-3 col-sm-6"
                                                        style="text-align: left;display: inline-block;width: 25%;max-width: 100%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content pt-sm-0px pb-sm-0px"
                                                                        style="vertical-align: top;padding: 10px;padding-bottom: 0px;padding-top: 0px;">
                                                                        <small style="color: #8e969f;">For</small>
                                                                        <p
                                                                            style="margin: 0 0 10px 0;mso-line-height-rule: exactly;">
                                                                            <strong>{{ principal}} {{ currency.ticker}}</strong></p>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div class="col col-3 col-sm-6"
                                                        style="text-align: left;display: inline-block;width: 25%;max-width: 100%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content pt-sm-0px pb-sm-0px"
                                                                        style="vertical-align: top;padding: 10px;padding-bottom: 0px;padding-top: 0px;">
                                                                        <small style="color: #8e969f;">APR</small>
                                                                        <p
                                                                            style="margin: 0 0 10px 0;mso-line-height-rule: exactly;">
                                                                            <strong>{{formatAPR apr}}</strong></p>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div class="col col-3 col-sm-6"
                                                        style="text-align: left;display: inline-block;width: 24%;max-width: 100%;vertical-align: top;">
