<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office"
  style="background: #ffffff;margin: 0 auto;padding: 0;width: 100%;height: 100%;background-color: #ffffff;">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
  <title></title>
  <style type="text/css">
    @media only screen and (max-width:575px) {
      .col-sm-6 {
        width: 50% !important;
        max-width: 50% !important
      }

      .col-sm-12 {
        width: 100% !important;
        max-width: 100% !important
      }

      .fs-sm-16px {
        font-size: 16px !important
      }

      .fs-sm-44px {
        font-size: 44px !important
      }

      .p-sm-10px {
        padding: 10px !important
      }

      .p-sm-5px {
        padding: 5px !important
      }

      .pb-sm-0px {
        padding-bottom: 0 !important
      }

      .pb-sm-20px {
        padding-bottom: 20px !important
      }

      .pb-sm-30px {
        padding-bottom: 30px !important
      }

      .pl-sm-10px {
        padding-left: 10px !important
      }

      .pl-sm-20px {
        padding-left: 20px !important
      }

      .pr-sm-10px {
        padding-right: 10px !important
      }

      .pr-sm-20px {
        padding-right: 20px !important
      }

      .pt-sm-0px {
        padding-top: 0 !important
      }

      .pt-sm-20px {
        padding-top: 20px !important
      }

      .w-sm-100per {
        width: 100% !important
      }

      .w-sm-120px {
        width: 120px !important
      }

      .w-sm-42px {
        width: 42px !important
      }

      .w-sm-55px {
        width: 55px !important
      }
    }
  </style>
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no">
  <style type="text/css">
    a {
      text-decoration: none;
    }

    .container {
      .row-content:not(:last-child) {
        margin-bottom: 20px;
      }
    }
  </style>
  <style type="text/css">
    .visible-outlook {
      display: none !important;
    }

    a[x-apple-data-detectors],
    .unstyle-auto-detected-links a {
      border-bottom: 0 !important;
      cursor: default !important;
      color: inherit !important;
      text-decoration: none !important;
      font-size: inherit !important;
      font-family: inherit !important;
      font-weight: inherit !important;
      line-height: inherit !important;
    }
  </style>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Lato:300,400,900&amp;display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400&amp;display=swap">
</head>

<body class="dark-background"
  style="background: transparent;margin: 0 auto;padding: 0;width: 100%;height: 100%;background-color: transparent;">
  <table role="presentation" cellspacing="0" cellpadding="0" width="100%"
    style="background: transparent;border-collapse: collapse;background-color: transparent;">
    <tbody>
      <tr><!--[if mso]>
 <td></td> <![endif]-->
        <td class="body-content p-sm-5px dark-background"
          style="font-size: 16px;color: #212529;font-weight: normal;line-height: 1.45;text-align: left;-webkit-text-size-adjust: 100%;-ms-text-size-adjust: 100%;padding: 40px;padding-top: 40px;font-family: Lato, sans-serif;">
          <table class="ms-t1 spacer" role="presentation" border="0" cellpadding="0" cellspacing="0"
            style="border-collapse: collapse;width: 100%;height: 25px;">
            <tbody>
              <tr>
                <td width="100%" height="25"></td>
              </tr>
            </tbody>
          </table>
          <table class="ms-t1 container" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
            style="border-collapse: collapse;width: 100%;max-width: 680px;margin: 0 auto;">
            <tbody>
              <tr>
                <td class="container-content"
                  style="padding: 0px;vertical-align: top;max-width: 680px;padding-bottom: 20px;padding-top: 10px;">
                  <center>
                    <img class="img-fluid w-sm-120px" src="{{ logoUrl }}"
                      style="display: block;height: auto;width: 150px;max-width: 100%;">
                  </center>
                </td>
              </tr>
            </tbody>
          </table>
          <table class="ms-t1 container dark-container iphone14BG" width="100%" border="0" cellpadding="0"
            cellspacing="0" role="presentation"
            style="border-collapse: collapse;width: 100%;max-width: 680px;margin: 0 auto;">
            <tbody>
              <tr>
                <td class="container-content pr-sm-10px pl-sm-10px p-sm-10px iphone14BG"
                  style="padding: 0px;vertical-align: top;max-width: 680px;border-radius: 308px;border-bottom-right-radius: 10px;border-bottom-left-radius: 10px;border-top-left-radius: 10px;border-top-right-radius: 10px;">
                  <center>
                    <h1 class="text-center dark-h1 fs-sm-44px"
                      style="font-weight: bold;margin: 0 0 10px 0;mso-line-height-rule: exactly;color: #343a40;font-size: 51px;line-height: 60px;text-align: center;">
                      {{ title }}
                    </h1>
                    {{#if subtitle}}
                    <p style="margin: 0 0 10px 0;mso-line-height-rule: exactly;color: #343a40;margin-top: 20px;font-size: 20px;">{{subtitle}}</p>
                    {{/if}}
                    <center>
                      
                      <table class="ms-t1 layout-table" role="presentation" border="0" cellpadding="0" cellspacing="0"
                        style="background: #f4f3f8;border-collapse: collapse;border-radius: 40px;background-color: #f4f3f8;">
                        <tbody>
                          <tr>
                             <td width="24" style="width: 24px;padding: 5px;padding-left: 9px;">
                              <img class="img-fluid" src="{{ walletUrl }}" style="display: block;width: 24px;height: 24px;max-width: 100%;">
                            </td>
                            <td>
                              <p
                                style="mso-line-height-rule: exactly;margin: 10px;margin-right: 20px;margin-bottom: 7px;margin-top: 7px;font-family: Roboto, sans-serif;margin-left: 4px;font-size: 18px;">
                                {{ compactAddress walletAddress }}</p>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </center>
                  </center>
                  <table class="ms-t1 spacer" role="presentation" border="0" cellpadding="0" cellspacing="0"
                    style="border-collapse: collapse;width: 100%;height: 25px;">
                    <tbody>
                      <tr>
                        <td width="100%" height="25"></td>
                      </tr>
                    </tbody>
                  </table>