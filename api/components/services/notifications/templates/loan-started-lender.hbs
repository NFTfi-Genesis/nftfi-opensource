{{> header title="Your offer has been accepted" logoUrl=logoUrl walletUrl=walletUrl walletAddress=lender }}

<table class="row h-align-left v-align-middle" border="0" cellpadding="0" cellspacing="0" role="presentation"
    style="border-collapse: collapse;width: 100%;">
    <tbody>
        <tr>
            <td class="row-content"
                style="background: #f4f3f8;vertical-align: top;background-color: #f4f3f8;border-radius: 20px;text-align: left;">
                <div class="col col-5 col-sm-12"
                    style="text-align: left;display: inline-block;width: 41%;max-width: 41%;vertical-align: middle;">
                    <table class="ms-t1 col-table" width="100%" border="0" cellpadding="0" cellspacing="0"
                        role="presentation" style="border-collapse: collapse;width: 100%;vertical-align: top;">
                        <tbody>
                            <tr>
                                <td class="col-content p-sm-10px pr-sm-20px pl-sm-20px pt-sm-20px"
                                    style="vertical-align: top;padding-left: 40px;padding-top: 40px;padding-bottom: 30px;">
                                    <img class="img-fluid w-sm-100per" src="{{ imagePreviewUrl }}"
                                        style="display: block;height: auto;border-width: 10.5px;border-radius: 10px;max-width: 100%;">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col col-7 col-sm-12"
                    style="text-align: left;display: inline-block;width: 58%;max-width: 58%;vertical-align: middle;">
                    <table class="ms-t1 col-table" width="100%" border="0" cellpadding="0" cellspacing="0"
                        role="presentation" style="border-collapse: collapse;width: 100%;vertical-align: top;">
                        <tbody>
                            <tr>
                                <td class="col-content pr-sm-20px pl-sm-20px"
                                    style="vertical-align: top;padding-right: 30px;padding-left: 30px;">
                                    <table class="row h-align-left v-align-top" border="0" cellpadding="0"
                                        cellspacing="0" role="presentation"
                                        style="border-collapse: collapse;width: 100%;">
                                        <tbody>
                                            <tr>
                                                <td class="row-content" style="vertical-align: top;text-align: left;">
                                                    <div class="col col-12"
                                                        style="text-align: left;display: inline-block;width: 100%;max-width: 100%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content"
                                                                        style="vertical-align: top;">
                                                                        <h1
                                                                            style="font-weight: bold;margin: 0 0 10px 0;mso-line-height-rule: exactly;font-size: 175%;margin-bottom: 0px;">
                                                                            <strong><span
                                                                                    style="color: rgb(22, 21, 45);">{{
                                                                                    assetName }}</span></strong>
                                                                        </h1><a href="#"
                                                                            style="text-decoration: none;color: #cb2b83;">{{
                                                                            assetCategory }}</a>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <table class="row h-align-left v-align-top" border="0" cellpadding="0"
                                        cellspacing="0" role="presentation"
                                        style="border-collapse: collapse;width: 100%;">
                                        <tbody>
                                            <tr>
                                                <td class="row-content" style="vertical-align: top;text-align: left;">
                                                    <div class="col col-12"
                                                        style="text-align: left;display: inline-block;width: 100%;max-width: 100%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content"
                                                                        style="vertical-align: top;"><small>Loan
                                                                            ID&nbsp;</small><small><strong>{{ loanId
                                                                                }}</strong></small>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col col-12"
                    style="text-align: left;display: inline-block;width: 100%;max-width: 100%;vertical-align: middle;">
                    <table class="ms-t1 col-table" width="100%" border="0" cellpadding="0" cellspacing="0"
                        role="presentation" style="border-collapse: collapse;width: 100%;vertical-align: top;">
                        <tbody>
                            <tr>
                                <td class="col-content pr-sm-10px pl-sm-10px"
                                    style="vertical-align: top;padding-right: 30px;padding-left: 30px;">
                                    <table class="row h-align-left v-align-top" border="0" cellpadding="0"
                                        cellspacing="0" role="presentation"
                                        style="border-collapse: collapse;width: 100%;">
                                        <tbody>
                                            <tr>
                                                <td class="row-content" style="vertical-align: top;text-align: left;">
                                                    <div class="col col-12 col-sm-12"
                                                        style="text-align: left;display: inline-block;width: 100%;max-width: 100%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content p-sm-10px pb-sm-0px pt-sm-0px"
                                                                        style="vertical-align: top;padding-right: 10px;padding-left: 10px;">
                                                                        <p style="margin: 0 0 10px 0;mso-line-height-rule: exactly;margin-top: 5px;margin-bottom: 5px;margin-right: 0px;margin-left: 0px;"
                                                                            class="mt-sm-10px dark-paragraph mb-sm-20px">
                                                                            Borrower <span
                                                                                style="text-decoration: underline;">{{ compactAddress borrower }}</span>
                                                                            has accepted your loan offer on
                                                                            <strong>{{ assetName
                                                                                }}</strong>.<br><br><strong>{{ principal
                                                                                }}
                                                                                {{ currency.ticker }}</strong> has been
                                                                            transferred from
                                                                            you to the borrower and <strong>{{ assetName }}</strong> has been placed in
                                                                            escrow.<br><br>The borrower must repay
                                                                            <strong>{{ repayment }} {{ currency.ticker
                                                                                }}</strong> within
                                                                            <strong>{{ durationDays }} days</strong>,
                                                                            before <strong>{{ dueTime }}</strong> or the
                                                                            asset becomes yours to claim.
                                                                        </p>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <table class="row h-align-center v-align-top" border="0" cellpadding="0"
                                        cellspacing="0" role="presentation"
                                        style="border-collapse: collapse;width: 100%;">
                                        <tbody>
                                            <tr>
                                                <td class="row-content" style="vertical-align: top;text-align: center;">
                                                    <div class="col col-6 col-sm-12"
                                                        style="text-align: left;display: inline-block;width: 50%;max-width: 50%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content pb-sm-20px pt-sm-0px"
                                                                        style="vertical-align: top;padding-right: 10px;padding-left: 10px;padding-top: 10px;padding-bottom: 10px;">
                                                                        <table
                                                                            class="ms-t2 btn btn-primary btn-md btn-rect"
                                                                            style="font-family: Roboto, sans-serif;width: 100%;border-collapse: separate;"
                                                                            border="0" cellpadding="0" cellspacing="0"
                                                                            role="presentation">
                                                                            <tbody>
                                                                                <tr>
                                                                                    <td class="btn-content"
                                                                                        style="background: #cb2b83;padding: 10px 20px;border: none;cursor: pointer;text-align: center;vertical-align: middle;font-weight: 800;border-radius: 0;background-color: #cb2b83;">
                                                                                        <a href="{{ assetUrl }}"
                                                                                            style="text-decoration: none;color: #fff;"><strong>View
                                                                                                loan</strong></a>
                                                                                    </td>
                                                                                </tr>
                                                                            </tbody>
                                                                        </table>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <table class="row h-align-left v-align-top" border="0" cellpadding="0"
                                        cellspacing="0" role="presentation"
                                        style="border-collapse: collapse;width: 100%;">
                                        <tbody>
                                            <tr>
                                                <td class="row-content" style="vertical-align: top;text-align: left;">
                                                    <div class="col col-12 col-sm-12"
                                                        style="text-align: left;display: inline-block;width: 100%;max-width: 100%;vertical-align: top;">
                                                        <table class="ms-t1 col-table" width="100%" border="0"
                                                            cellpadding="0" cellspacing="0" role="presentation"
                                                            style="border-collapse: collapse;width: 100%;vertical-align: top;">
                                                            <tbody>
                                                                <tr>
                                                                    <td class="col-content pb-sm-20px pt-sm-0px"
                                                                        style="vertical-align: top;padding: 10px;padding-bottom: 20px;padding-top: 10px;padding-right: 10px;padding-left: 10px;">
                                                                        <p class="text-center"
                                                                            style="margin: 0 0 10px 0;mso-line-height-rule: exactly;text-align: center;">
                                                                            <strong>Please note: </strong>do not rely
                                                                            solely on email notifications to get
                                                                            information about your loans. <br><br>Start
                                                                            using calendar notifications, <a href="#"
                                                                                style="text-decoration: none;color: #0a6fe4;"><span
                                                                                    style="color: rgb(203, 43, 131);">learn
                                                                                    more here</span></a>.
                                                                        </p>
                                                                    </td>
                                                                </tr>
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </td>
        </tr>
    </tbody>
</table>

{{> footer url=nftfiUrl twitterUrl=twitterUrl discordUrl=discordUrl }}