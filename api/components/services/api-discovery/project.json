{
  "name": "services-api-discovery",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "components/services/api-discovery/src",
  "projectType": "application",
  "targets": {
    "init": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "chmod +x $NX_WORKSPACE_ROOT/scripts/service-init.sh",
          "$NX_WORKSPACE_ROOT/scripts/service-init.sh $NX_PROJECT_ROOT"
        ],
        "env": {
          "NX_PROJECT_ROOT": "components/services/api-discovery"
        }
      }
    },
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "target": "node",
        "outputPath": "components/services/api-discovery/dist",
        "main": "components/services/api-discovery/src/main.ts",
        "tsConfig": "components/services/api-discovery/tsconfig.json",
        "webpackConfig": "components/services/webpack.config.js",
        "babelConfig": ".babelrc",
        "sourceMap": true
      },
      "configurations": {
        "production": {
          "generatePackageJson": true
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "services-api-discovery:build",
        "inspect": false
      }
    },
    "lint-types": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "tsc --noEmit -p components/services/api-discovery/tsconfig.app.json"
          }
        ]
      }
    }
  },
  "tags": []
}
