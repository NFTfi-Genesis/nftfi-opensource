{
  "name": "nftfi-api",
  "version": "v2.48.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nx run-many --all --targets=build",
    "ci:build:openapi": "yarn nx serve tools-api-discovery-dumper --args=\"--name=${EP_NAME},--path=swagger.json,--spec-version=2,--include-options\"",
    "init:services": "nx run-many --all --targets=init",
    "postinstall": "husky install || true && yarn init:services",
    "lint": "eslint . --max-warnings=0",
    "lint:types": "yarn nx run-many --all --targets=lint-types",
    "openapi:authorization": "yarn nx serve tools-api-discovery-dumper --args=\"--name=${EP_NAME},--path=tmp/openapi/authorization.json,--service=authorization,--forward-url=https://sdk-api.nftfi.com\"",
    "openapi:loans": "yarn nx serve tools-api-discovery-dumper --args=\"--name=${EP_NAME},--path=tmp/openapi/loans.json,--service=loans,--forward-url=https://sdk-api.nftfi.com\"",
    "openapi:offers": "yarn nx serve tools-api-discovery-dumper --args=\"--name=${EP_NAME},--path=tmp/openapi/offers.json,--service=offers,--forward-url=https://sdk-api.nftfi.com\"",
    "serve:core": "docker-compose --profile core up -d --build --force-recreate",
    "start": "node main.js",
    "start:dev": "chmod +x ./docker/run-dev.sh && ./docker/run-dev.sh",
    "tb:check": "tb --cloud deploy --check",
    "test": "jest --config ./jest.config.js",
    "typeorm:cli": "dotenvx run --env-file=.env --overload -- ts-node -P tsconfig.typeorm-cli.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:migration:create": "yarn typeorm:cli migration:create",
    "typeorm:migration:generate": "yarn typeorm:cli migration:generate -d ./components/repositories/src/postgres/datasource-cli.ts",
    "typeorm:migration:revert": "yarn typeorm:cli migration:revert -d ./components/repositories/src/postgres/datasource-cli.ts",
    "typeorm:migration:run": "yarn typeorm:cli migration:run -d ./components/repositories/src/postgres/datasource-cli.ts",
    "typeorm:migration:show": "yarn typeorm:cli migration:show -d ./components/repositories/src/postgres/datasource-cli.ts"
  },
  "resolutions": {
    "stream-shift": "1.0.2"
  },
