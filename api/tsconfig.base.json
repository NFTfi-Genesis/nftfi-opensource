{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2017"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strictPropertyInitialization": false,
    "baseUrl": ".",
    "allowJs": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@nftfi.api/core": ["components/core/src/index.ts"],
      "@nftfi.api/core/*": ["components/core/src/*"],
      "@nftfi.api/facades/factories/*": ["components/facades/test/factories/*"],
      "@nftfi.api/facades": ["components/facades/src/index.ts"],
      "@nftfi.api/facades/*": ["components/facades/src/*"],
      "@nftfi.api/repositories/factories": ["components/repositories/test/factories/index.ts"],
      "@nftfi.api/repositories/factories/*": ["components/repositories/test/factories/*"],
      "@nftfi.api/repositories/postgres/factories/*": ["components/repositories/test/postgres/*.factory.ts"],
      "@nftfi.api/repositories": ["components/repositories/src/index.ts"],
      "@nftfi.api/repositories/*": ["components/repositories/src/*"],
      "@nftfi.api/repositories/postgres": ["components/repositories/src/postgres/datasource.ts"],
      "@nftfi.api/services/api-discovery": ["components/services/api-discovery/src/index.ts"],
      "@nftfi.api/services/assets": ["components/services/assets/src/index.ts"],
      "@nftfi.api/services/fx-rates": ["components/services/assets/src/fx-rate/index.ts"],
      "@nftfi.api/services/assets/factories": ["components/services/assets/test/factories/index.ts"],
      "@nftfi.api/services/accounts": ["components/services/accounts/src/index.ts"],
      "@nftfi.api/services/offers": ["components/services/offers/src/index.ts"],
      "@nftfi.api/services/loans": ["components/services/loans/src/index.ts"],
      "@nftfi.api/services/loans/subscribers/*": ["components/services/loans/src/subscribers/*"],
      "@nftfi.api/migrations": ["components/migrations/src/index.ts"],
      "@nftfi.api/validation": ["components/validation/src/index.ts"],
      "@nftfi.api/validation/*": ["components/validation/src/*"],
      "@nftfi.api/modules/ethers-observer/factories/*": ["components/modules/test/ethers-observer/factories/*"],
      "@nftfi.api/modules/*": ["components/modules/src/*"]
    }
  },
  "exclude": ["node_modules"]
}
