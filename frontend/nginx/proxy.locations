# ===== Proxy Base =====
location /proxy/ {
    resolver 8.8.8.8;
    resolver_timeout 60s;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;
}

# ===== Alchemy =====

# Exact match (prevents auto redirect)
location = /proxy/alchemy {
    resolver 8.8.8.8;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;

    proxy_pass ${REACT_APP_ALCHEMY_API_URL}${REACT_APP_ALCHEMY_API_KEY}/;
}

# With trailing slash
location /proxy/alchemy/ {
    resolver 8.8.8.8;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;

    proxy_pass ${REACT_APP_ALCHEMY_API_URL}${REACT_APP_ALCHEMY_API_KEY}/;
}

# ===== OpenSea =====

# Exact match
location = /proxy/opensea {
    resolver 8.8.8.8;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;

    proxy_pass ${REACT_APP_OPENSEA_API_URL};
    proxy_set_header X-API-KEY ${REACT_APP_OPENSEA_API_KEY};
}

# With trailing slash
location /proxy/opensea/ {
    resolver 8.8.8.8;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;

    proxy_pass ${REACT_APP_OPENSEA_API_URL};
    proxy_set_header X-API-KEY ${REACT_APP_OPENSEA_API_KEY};
}

# ===== alchemy-fallback =====

# Exact match
location = /proxy/alchemy-fallback {
    resolver 8.8.8.8;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;

    proxy_pass ${REACT_APP_ALCHEMY_API_URL}${REACT_APP_ALCHEMY_API_KEY}/;
}

# With trailing slash
location /proxy/alchemy-fallback/ {
    resolver 8.8.8.8;
    proxy_ssl_server_name on;
    proxy_http_version 1.1;

    proxy_pass ${REACT_APP_ALCHEMY_API_URL}${REACT_APP_ALCHEMY_API_KEY}/;
}
