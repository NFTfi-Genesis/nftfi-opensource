# ---------------------------------------------------------------------------
# NFTfi frontend — environment template. Copy to `.env` and fill in.
# The app reads these at build time; see src/config/buildConfig.ts for the
# authoritative list and how each is used.
# ---------------------------------------------------------------------------

# --- Required ---
# Dynamic.xyz environment id (wallet auth) — https://app.dynamic.xyz
VITE_DYNAMIC_KEY=your-dynamic-environment-id
# Same-origin proxy base that fronts third-party APIs (see nginx/proxy.locations).
# Alchemy / Reservoir / OpenSea calls are routed through `${VITE_PROXY_URL}/...`.
VITE_PROXY_URL=https://your-host.example.com/proxy
# NFTfi API endpoints
VITE_NFTFI_API_URL=https://api.example.com
VITE_NFTFI_SDK_API_URL=https://sdk-api.example.com
VITE_NFTFI_SDK_API_KEY=your-sdk-api-key
# Dashboard / analytics API host
VITE_DASHBOARD_API_HOST=https://dashboard-api.example.com

# --- Optional (have fallbacks / feature toggles) ---
# Direct RPC; if unset, falls back to `${VITE_PROXY_URL}/alchemy`
VITE_FALLBACK_RPC_URL=https://eth-mainnet.example.com/v2/your-key
VITE_FEATURE_FLAG_SHOW_DASHBOARD=false
VITE_SHOW_DATA_TEST_IDS=false
VITE_GOOGLE_ANALYTICS_ID=
VITE_TERMS_OF_SERVICE_URL=https://example.com/terms-and-conditions/
VITE_TERMS_OF_USE_URL=https://example.com/terms-of-use/
# Build metadata — usually injected by CI
VITE_TAG_NAME=
VITE_SHORT_SHA=

# --- Local dev / testing (optional) ---
# Enable MSW request mocking in dev
VITE_ACTIVATE_MSW=false
# Impersonate a wallet locally (dev only)
VITE_IMPERSONATED_WALLET=
# Map of impersonated wallets, JSON: { "<from-address>": "<to-address>" } (dev only)
VITE_IMPERSONATED_WALLETS_MAP=
# Serve a canned NFT list for the given wallet(s) without hitting the API (dev only).
# JSON array of { owner, nfts: [{ address, id }] }. Example below uses synthetic data:
VITE_TEST_NFTS='[{"owner":"0x1111111111111111111111111111111111111111","nfts":[{"address":"0x8a90cab2b38dba80c64b7734e58ee1db38b8992e","id":"1"}]}]'

# --- nginx proxy (deploy-time only; if you serve behind the provided nginx/ config) ---
# The proxy injects these server-side so keys never reach the browser.
REACT_APP_ALCHEMY_API_URL=https://eth-mainnet.g.alchemy.com/v2/
REACT_APP_ALCHEMY_API_KEY=your-alchemy-key
REACT_APP_OPENSEA_API_URL=https://api.opensea.io/
REACT_APP_OPENSEA_API_KEY=your-opensea-key
