{
  "name": "nftfi.ns.dapp",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.ignorecase false || true",
    "install:docker": "/bin/bash -c 'eval `ssh-agent` && ssh-add && NODE_ENV=development yarn install' ",
    "start": "docker-compose up",
    "validate-config": "yarn tsx src/config/validateConfig.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
