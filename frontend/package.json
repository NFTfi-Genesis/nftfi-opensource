    "fuse.js": "^7.1.0",
    "i18next": "^23.14.0",
    "jazzicon": "^1.5.0",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "notistack": "3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
