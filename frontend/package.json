    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/lodash": "^4.17.7",
    "@types/node": "^22.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "eslint": "^9.8.0",
