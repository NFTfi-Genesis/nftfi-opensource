# RPC URLs. MAINNET_RPC_URL is used by fork tests and the read-only state verifier.
# MAINNET_RPC_URL=https://ethereum-mainnet.example/v2/replace-me
# ETH_MAINNET_RPC_URL=https://ethereum-mainnet.example/v2/replace-me
# ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia.example/v2/replace-me
# BASE_SEPOLIA_RPC_URL=https://base-sepolia.example/v2/replace-me
# VIRTUAL_MAINNET_RPC_URL=https://virtual.mainnet.rpc.tenderly.co/replace-me
# TENDERLY_PLUGIN_ENABLED=true

# Provider-key fallbacks retained for compatibility with the historical tooling.
# INFURA_API_KEY=replace-me
# ALCHEMY_API_KEY=replace-me
# GAS_PRICE=1000000000

# Explorer and Tenderly verification.
# ETHERSCAN_KEY=replace-me
# TENDERLY_NETWORK_SLUG=replace-me
# TENDERLY_ACCESS_TOKEN=replace-me
# TENDERLY_USERNAME=replace-me
# TENDERLY_PROJECT=replace-me

# Deployment accounts. Never commit real values.
# ETH_MAINNET_PRIVATE_KEY=0x...
# ETH_MAINNET_OWNER_ADDRESS=0x...
# ETH_MAINNET_V1_PRIVATE_KEY=0x...
# ETH_MAINNET_V1_ADDRESS=0x...
# ETH_SEPOLIA_PRIVATE_KEY=0x...
# ETH_SEPOLIA_OWNER_ADDRESS=0x...
# BASE_SEPOLIA_PRIVATE_KEY=0x...
# BASE_SEPOLIA_OWNER_ADDRESS=0x...
# VIRTUAL_MAINNET_PRIVATE_KEY=0x...
# VIRTUAL_MAINNET_OWNER_ADDRESS=0x...

# Permit-list refresh tooling.
# PERMITTED_NFTS_API_URL=https://project-metadata.example/projects
# API_USER_AGENT=nftfi-protocol-development
